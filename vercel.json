{
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/v1/keepers/[action].ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/app/admin/:path*",
      "destination": "/admin/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/admin/:path*", "destination": "/app/index.html" },
    { "source": "/docs/:path*", "destination": "/docs/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/:base(app|admin)/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://horizon.stellar.org https://horizon-testnet.stellar.org https://ewqw4hx7oa.execute-api.us-east-1.amazonaws.com; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
