# rxjs (pulled in transitively via @creit.tech/xbull-wallet-connect, #598)
# declares tslib as its own dependency, but pnpm's strict per-package
# isolation has been observed failing to link tslib into rxjs's own nested
# node_modules on Vercel's cached install (though not on every fresh local
# install), breaking the production build with "Rolldown failed to resolve
# import tslib". Hoisting it to root node_modules makes it resolvable via
# Node's normal upward directory walk regardless of whether that specific
# nested link is correctly wired.
public-hoist-pattern[]=tslib

# Vercel's Serverless Functions builder (@vercel/node) runs its own
# per-file TypeScript type-check against api/**/*.ts, separate from
# `pnpm typecheck`/`pnpm typecheck:api`. That check used to fail in
# production to resolve exports of @meridian/shared, @meridian/api-core,
# and @meridian/stellar-sdk-helpers that genuinely exist in source. The
# root cause was declaration staleness, not pnpm's node_modules layout:
# Vercel restores packages/*/dist from the previous deployment's build
# cache, and the function type-check resolved @meridian/* through those
# emitted .d.ts files, which predated the current exports (TS2305). The
# fix lives in api/tsconfig.json, which now maps @meridian/* to live
# workspace src so the check no longer depends on dist freshness.
# shamefully-hoist is kept because flattening dependencies into root
# node_modules (in addition to, not instead of, the normal symlink tree)
# remains the standard fix for tools that aren't written with pnpm's
# strict, symlinked layout in mind.
shamefully-hoist=true
