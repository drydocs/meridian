{
  "version": 1,
  "contract_version": "1.0.0",
  "virtual_offset": "1000",
  "performance_fee_bps": "1000",
  "bps_denominator": "10000",
  "vectors": [
    {
      "name": "zero_assets_deposit",
      "description": "First deposit into an empty vault with 0 assets and 0 shares.",
      "kind": "deposit",
      "inputs": {
        "assets": "10000000",
        "total_assets": "0",
        "total_shares": "0"
      },
      "expected": {
        "shares_out": "10000000",
        "share_price": "10000000"
      }
    },
    {
      "name": "standard_deposit_inflation_protection",
      "description": "Deposit into an active vault using virtual offset.",
      "kind": "deposit",
      "inputs": {
        "assets": "5000000",
        "total_assets": "100000000",
        "total_shares": "100000000"
      },
      "expected": {
        "shares_out": "5000000",
        "share_price": "10000000"
      }
    },
    {
      "name": "withdrawal_payout_raw_ratio",
      "description": "Withdrawal payout using raw asset-to-share ratio without virtual offset.",
      "kind": "withdrawal_payout",
      "inputs": {
        "shares": "10000000",
        "total_assets": "110000000",
        "total_shares": "100000000"
      },
      "expected": {
        "assets_out": "11000000"
      }
    },
    {
      "name": "split_withdrawal_payout",
      "description": "Split withdrawal payout for partial shares.",
      "kind": "withdrawal_payout",
      "inputs": {
        "shares": "5000000",
        "total_assets": "100000000",
        "total_shares": "100000000"
      },
      "expected": {
        "assets_out": "5000000"
      }
    },
    {
      "name": "partial_withdraw_with_fee",
      "description": "Partial withdrawal of half a position with accumulated yield and performance fee.",
      "kind": "fee",
      "inputs": {
        "usdc_out": "55000000",
        "principal_out": "50000000",
        "fee_bps": "1000",
        "bps_denominator": "10000"
      },
      "expected": {
        "gain": "5000000",
        "fee": "500000"
      }
    },
    {
      "name": "loss_withdrawal_no_fee",
      "description": "Withdrawal at a loss results in zero gain and zero performance fee.",
      "kind": "loss_withdrawal",
      "inputs": {
        "usdc_out": "90000000",
        "principal_out": "100000000",
        "fee_bps": "1000",
        "bps_denominator": "10000"
      },
      "expected": {
        "gain": "0",
        "fee": "0"
      }
    },
    {
      "name": "zero_stroop_edge",
      "description": "Zero asset or share edges.",
      "kind": "edge",
      "inputs": {
        "assets": "0",
        "total_assets": "0",
        "total_shares": "0"
      },
      "expected": {
        "shares_out": "0",
        "share_price": "0"
      }
    },
    {
      "name": "one_stroop_edge",
      "description": "One stroop deposit edge.",
      "kind": "edge",
      "inputs": {
        "assets": "1",
        "total_assets": "0",
        "total_shares": "0"
      },
      "expected": {
        "shares_out": "1",
        "share_price": "1"
      }
    }
  ]
}
