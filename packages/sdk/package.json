{
  "name": "@meridian/sdk",
  "version": "0.1.0",
  "description": "Typed building blocks for integrating with Meridian vaults and strategies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=14 <16"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
