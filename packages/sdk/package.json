{
  "name": "@meridian/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Meridian vaults, keepers and the Blend adapter on Stellar.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --reporter=html --reporter=text",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "tsup": "^8.5.0",
    "vitest": "^5.0.0"
  }
}
