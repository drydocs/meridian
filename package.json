{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-version.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "check:links": "lychee --config lychee.toml --offline --no-progress --hidden \"**/*.md\"",
    "check:links:external": "lychee --config lychee.toml --no-progress --hidden \"**/*.md\"",
    "test:csp-hashes": "node scripts/check-csp-hashes.mjs",
    "test:security-headers": "node scripts/check-security-headers.mjs",
    "verify:contracts": "tsx scripts/verify-contract-addresses.ts",
    "check:wasm-size": "tsx scripts/check-wasm-size.ts",
    "check:contract-benchmarks": "tsx scripts/check-contract-benchmarks.ts",
    "bundle:check": "pnpm --filter @meridian/web bundle:check",
    "write:deployment-manifest": "tsx scripts/write-deployment-manifest.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "prettier": "^3.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "markdownlint-cli2": "^0.24.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.70.0"
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "katex": ">=0.18.2"
    }
  }
}
